{
  "allow-lan": false,
  "bind-address": "127.0.0.1",
  "log-level": "warning",
  "mixed-port": 17890,
  "mode": "rule",
  "proxies": [
    {
      "alpn": [
        "http/1.1"
      ],
      "client-fingerprint": "chrome",
      "name": "United Kingdom",
      "network": "ws",
      "packet-encoding": "xudp",
      "port": 443,
      "server": "192.0.2.30",
      "servername": "example.com",
      "tls": true,
      "type": "vless",
      "uuid": "00000000-0000-4000-8000-000000000001",
      "ws-opts": {
        "headers": {
          "Host": "cdn.example.com"
        },
        "path": "/proxy",
        "v2ray-http-upgrade": true
      }
    },
    {
      "cipher": "aes-128-gcm",
      "name": "United States",
      "password": "synthetic-fixture-secret",
      "port": 8388,
      "server": "192.0.2.20",
      "type": "ss"
    }
  ],
  "proxy-groups": [
    {
      "name": "Choose",
      "proxies": [
        "United Kingdom",
        "United States"
      ],
      "type": "select"
    }
  ],
  "rules": [
    "DOMAIN-SUFFIX,example.org,Choose",
    "MATCH,DIRECT"
  ]
}
